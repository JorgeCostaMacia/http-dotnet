<Project>

	<!-- Central Package Management: all package versions live here, in one place. JorgeCostaMacia.DDD.Exception
	     (ddd-dotnet) is a published package like any third-party one, versioned here too. Inter-package
	     JorgeCostaMacia.Http.* deps (same repo) are ProjectReferences (lockstep versioning); pack
	     emits them as nuspec <dependency> at the shared version, so CPM doesn't manage them. -->
	<PropertyGroup>
		<ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
		<CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
	</PropertyGroup>

	<ItemGroup>
		<PackageVersion Include="Asp.Versioning.Http" Version="10.2.3" />
		<PackageVersion Include="Asp.Versioning.Mvc.ApiExplorer" Version="10.2.1" />
		<!-- Keep aligned with the FluentValidation that JorgeCostaMacia.DDD.Exception ships against — review both together on every DDD.Exception bump (a mismatch surfaces as NU1608 at restore). -->
		<PackageVersion Include="FluentValidation" Version="12.2.0" />
		<PackageVersion Include="JorgeCostaMacia.DDD.Exception" Version="11.0.0" />
		<PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.14" />
		<PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="10.0.14" />
		<PackageVersion Include="Microsoft.Extensions.Configuration" Version="10.0.14" />
		<PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.14" />
		<PackageVersion Include="Microsoft.SourceLink.GitHub" Version="10.0.403" />
		<PackageVersion Include="Serilog" Version="4.4.0" />
		<PackageVersion Include="Serilog.AspNetCore" Version="10.0.0" />
		<PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
		<PackageVersion Include="xunit.v3" Version="4.0.2" />
	</ItemGroup>

</Project>
